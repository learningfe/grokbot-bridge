[Unit]
Description=grokbot-bridge
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/grokbot-bridge
EnvironmentFile=%h/.config/grokbot-bridge/env
ExecStart=/usr/bin/node %h/.local/share/grokbot-bridge/dist/cli.js serve --config %h/.config/grokbot-bridge/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
